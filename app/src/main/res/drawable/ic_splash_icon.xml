<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen icon. The splash API masks the icon to a circle and the
    spec requires content within the inner 2/3 of the drawable bounds.
    108dp transparent canvas + 76dp centered artwork keeps the visible
    logo (~75% of the bitmap) safely inside that circle on every device.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="108dp"
        android:height="108dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="76dp"
        android:height="76dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/ic_launcher_icon_transparent"
            android:gravity="fill"
            android:tileMode="disabled" />
    </item>
</layer-list>
