<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude Google Drive OAuth tokens — re-auth on restore -->
    <exclude domain="sharedpref" path="kothagolp_secure_sync_prefs.xml" />
    <!-- Exclude WebView session data -->
    <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
    <!-- Exclude downloaded chapter cache (large, re-downloadable) -->
    <exclude domain="cache" path="." />
    <exclude domain="externalCache" path="." />
</full-backup-content>
